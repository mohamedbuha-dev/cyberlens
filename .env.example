# إعدادات بوابة البريد (IMAP) — انسخ هذا الملف إلى .env واملأ القيم.
#   cp .env.example .env
#
# لحساب Gmail تجريبي:
#   1) فعّل التحقق بخطوتين على الحساب.
#   2) أنشئ "App Password" من: https://myaccount.google.com/apppasswords
#   3) ضع البريد وكلمة مرور التطبيق (16 حرفًا) بالأسفل.
#
# اترك الحقول فارغة لتعطيل البوابة تمامًا (تبقى المنصة تعمل بالإدخال اليدوي).

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-test-account@gmail.com
IMAP_PASSWORD=your-16-char-app-password

# صندوق الوارد المراد فحصه (افتراضي INBOX)
IMAP_MAILBOX=INBOX

# فترة السحب بالثواني (كل كم ثانية نفحص الوارد الجديد)
IMAP_POLL_INTERVAL=20

# وضع علامة "مقروء" على الرسالة بعد تحليلها كي لا تتكرر (true/false)
IMAP_MARK_SEEN=true
